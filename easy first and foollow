#include <stdio.h>
#include <string.h>
#include <ctype.h>

#define MAX 50
#define EPS '#'

typedef struct {
    char lhs;
    char rhs[MAX][10]; // multiple RHS
    int count;
} Production;

Production prods[MAX];
int prod_count;

char non_terminals[MAX];
int nt_count;

char first[MAX][MAX];
int first_count[MAX];
char follow[MAX][MAX];
int follow_count[MAX];

int is_upper(char c) {
return c >= 'A' && c <= 'Z';
}


int index_nt(char c){ 
    for(int i=0;i<nt_count;i++) 
    if(non_terminals[i]==c)
    return i; 
    return -1; }

int contains(char* arr,int n,char c){
    for(int i=0;i<n;i++)
    if(arr[i]==c)
    return 1; 
    return 0;}


void add(char* arr,int* n,char c){ 
    if(!contains(arr,*n,c)) 
    arr[(*n)++]=c; }

void compute_first(){
    int changed;
    do{
        changed=0;
        for(int i=0;i<prod_count;i++){
            int lhs_idx=index_nt(prods[i].lhs);
            for(int j=0;j<prods[i].count;j++){
                char *rhs=prods[i].rhs[j];
                int k=0, eps=1;
                while(rhs[k] && eps){
                    eps=0;
                    char c=rhs[k];
                    if(!is_upper(c)){ 
                        if(!contains(first[lhs_idx],first_count[lhs_idx],c)){ 
                            add(first[lhs_idx],&first_count[lhs_idx],c); 
                            changed=1;}
                            break;}
                    int idx=index_nt(c);
                    for(int x=0;x<first_count[idx];x++)
                        if(first[idx][x]!=EPS && !contains(first[lhs_idx],first_count[lhs_idx],first[idx][x])){ 
                            add(first[lhs_idx],&first_count[lhs_idx],first[idx][x]); 
                            changed=1;}
                    if(contains(first[idx],first_count[idx],EPS)) 
                    eps=1;
                    k++;
                }
                if(eps && !contains(first[lhs_idx],first_count[lhs_idx],EPS)){
                    add(first[lhs_idx],&first_count[lhs_idx],EPS); 
                    changed=1;}
            }
        }
    }while(changed);
}

void compute_follow(){
    add(follow[0], &follow_count[0], '$'); // start symbol
    int changed;
    do{
        changed=0;
        for(int i=0;i<prod_count;i++){
            int lhs_idx=index_nt(prods[i].lhs);
            for(int j=0;j<prods[i].count;j++){
                char *rhs=prods[i].rhs[j];
                for(int k=0;rhs[k];k++){
                    if(!is_upper(rhs[k])) continue;
                    int B_idx=index_nt(rhs[k]);
                    int eps=1;
                    for(int l=k+1;l<strlen(rhs) && eps;l++){
                        eps=0;
                        char c=rhs[l];
                        if(!is_upper(c)){ 
if(!contains(follow[B_idx],follow_count[B_idx],c)){ 
add(follow[B_idx],&follow_count[B_idx],c);
changed=1;
} 
break;
}
                        int idx=index_nt(c);
                        for(int x=0;x<first_count[idx];x++)
                            if(first[idx][x]!=EPS && !contains(follow[B_idx],follow_count[B_idx],first[idx][x])){ 
add(follow[B_idx],&follow_count[B_idx],first[idx][x]);
changed=1;
}
                        if(contains(first[idx],first_count[idx],EPS)) 
eps=1;
                    }
                    if(eps){
                        for(int x=0;x<follow_count[lhs_idx];x++)
                            if(!contains(follow[B_idx],follow_count[B_idx],follow[lhs_idx][x])){ 
add(follow[B_idx],&follow_count[B_idx],follow[lhs_idx][x]); 
changed=1;
}
                    }
                }
            }
        }
    }while(changed);
}

int main(){
    printf("Enter number of productions: ");
    scanf("%d",&prod_count);
    getchar();

    for(int i=0;i<prod_count;i++){
        char line[100];
        printf("Production %d (A=Ab|c): ",i+1);
        fgets(line,sizeof(line),stdin);
        char *eq=strchr(line,'=');
        if(!eq){ printf("Invalid!\n"); i--; continue;}
        prods[i].lhs=line[0];
        if(!contains(non_terminals,nt_count,line[0])) non_terminals[nt_count++]=line[0];
        prods[i].count=0;
        char *token=strtok(eq+1,"|\n");
        while(token){ strcpy(prods[i].rhs[prods[i].count++],token); 
token=strtok(NULL,"|\n");}
    }

    for(int i=0;i<nt_count;i++)
first_count[i]=follow_count[i]=0;

    compute_first();
    compute_follow();

    printf("\nFIRST sets:\n");
    for(int i=0;i<nt_count;i++){
        printf("FIRST(%c) = { ", non_terminals[i]);
        for(int j=0;j<first_count[i];j++) 
printf("%c ",first[i][j]);
        printf("}\n");
    }
    printf("\nFOLLOW sets:\n");
    for(int i=0;i<nt_count;i++){
        printf("FOLLOW(%c) = { ", non_terminals[i]);
        for(int j=0;j<follow_count[i];j++) printf("%c ",follow[i][j]);
        printf("}\n");
    }
}
