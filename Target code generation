#include <stdio.h>
#include <string.h>

int main() {
    FILE *fp1, *fp2;
    char op, fir[10], sec[10], res[10], opr[10];

    // Open input and output files
    fp1 = fopen("inp_8086.txt", "r");
    if (fp1 == NULL) {
        printf("Error: cannot open inp_8086.txt\n");
        return 1;
    }
    printf("File opened successfully.\n");

    fp2 = fopen("result.txt", "w");
    if (fp2 == NULL) {
        printf("Error: cannot create result.txt\n");
        fclose(fp1);
        return 1;
    }

    // Read and process each line
    while (fscanf(fp1, " %c %s %s %s", &op, fir, sec, res) == 4) {
        printf("%c %s %s %s\n", op, fir, sec, res);

        // Map operator to 8086 instruction
        switch (op) {
            case '+': strcpy(opr, "ADD"); break;
            case '-': strcpy(opr, "SUB"); break;
            case '*': strcpy(opr, "MUL"); break;
            case '/': strcpy(opr, "DIV"); break;
            default:  strcpy(opr, "");    break;
        }

        // Load first operand into AX
        if (strlen(fir) == 2 && fir[0] == 't') {
            if (fir[1] == '1')
                fprintf(fp2, "MOV AX,BX\n");
            else if (fir[1] == '2')
                fprintf(fp2, "MOV AX,CX\n");
            else if (fir[1] == '3')
                fprintf(fp2, "MOV AX,DX\n");
        } else {
            fprintf(fp2, "MOV AX,%s\n", fir);
        }

        // Perform operation with second operand
        if (strlen(sec) == 2 && sec[0] == 't') {
            if (sec[1] == '1')
                fprintf(fp2, "%s AX,BX\n", opr);
            else if (sec[1] == '2')
                fprintf(fp2, "%s AX,CX\n", opr);
            else if (sec[1] == '3')
                fprintf(fp2, "%s AX,DX\n", opr);
        } else {
            fprintf(fp2, "%s AX,%s\n", opr, sec);
        }

        // Store result
        if (strlen(res) == 2 && res[0] == 't') {
            if (res[1] == '1')
                fprintf(fp2, "MOV BX,AX\n");
            else if (res[1] == '2')
                fprintf(fp2, "MOV CX,AX\n");
            else if (res[1] == '3')
                fprintf(fp2, "MOV DX,AX\n");
        }
    }

    fclose(fp1);
    fclose(fp2);
    printf("Conversion completed. Check result.txt.\n");

    return 0;
}
