#include <stdio.h>
#include <string.h>
#include <ctype.h>

struct Var {
    char name;
    float value;
    int isConstant;
} symtab[50];

int varCount = 0;

int getConstantValue(char name, float *val) {
    for (int i = 0; i < varCount; i++) {
        if (symtab[i].name == name) {
            if (symtab[i].isConstant) {
                *val = symtab[i].value;
                return 1;
            }
            return 0;
        }
    }
    return 0;
}

void updateVariable(char name, float value, int isConst) {
    for (int i = 0; i < varCount; i++) {
        if (symtab[i].name == name) {
            symtab[i].value = value;
            symtab[i].isConstant = isConst;
            return;
        }
    }
    symtab[varCount].name = name;
    symtab[varCount].value = value;
    symtab[varCount].isConstant = isConst;
    varCount++;
}

float calculate(float left, char op, float right) {
    switch (op) {
        case '+': return left + right;
        case '-': return left - right;
        case '*': return left * right;
        case '/': return right != 0 ? left / right : 0;
    }
    return 0;
}

int isVariable(char c) {
    return isalpha(c);
}

int main() {
    FILE *fp = fopen("inp.txt", "r");
    FILE *out = fopen("result.txt", "w");

    if (!fp || !out) {
        printf("Error opening file.\n");
        return 1;
    }

    char line[256];
    while (fgets(line, sizeof(line), fp)) {
        char target, left, right, op;
        float val;

        // Pattern 1: a = 5;
        if (sscanf(line, " %c = %f ;", &target, &val) == 2) {
            updateVariable(target, val, 1);
            fprintf(out, "%c=%g;\n", target, val);
            continue;
        }

        // Pattern 2: a = b + 3;
        if (sscanf(line, " %c = %c %c %f ;", &target, &left, &op, &val) == 4) {
            float lval;
            int lconst = getConstantValue(left, &lval);
            if (lconst) {
                float res = calculate(lval, op, val);
                updateVariable(target, res, 1);
                fprintf(out, "%c=%g;\n", target, res);
            } else {
                updateVariable(target, 0, 0);
                fprintf(out, "%c=%c %c %g;\n", target, left, op, val);
            }
            continue;
        }

        // Pattern 3: a = b + c;
        if (sscanf(line, " %c = %c %c %c ;", &target, &left, &op, &right) == 4) {
            float lval, rval;
            int lconst = getConstantValue(left, &lval);
            int rconst = getConstantValue(right, &rval);

            if (lconst && rconst) {
                float res = calculate(lval, op, rval);
                updateVariable(target, res, 1);
                fprintf(out, "%c=%g;\n", target, res);
            } else if (lconst) {
                fprintf(out, "%c=%g %c %c;\n", target, lval, op, right);
                updateVariable(target, 0, 0);
            } else if (rconst) {
                fprintf(out, "%c=%c %c %g;\n", target, left, op, rval);
                updateVariable(target, 0, 0);
            } else {
                fprintf(out, "%s", line);
                updateVariable(target, 0, 0);
            }
            continue;
        }

        // Otherwise, copy the line as is
        fprintf(out, "%s", line);
    }

    fclose(fp);
    fclose(out);

    printf("✅ Output written to result.txt\n");
    return 0;
}
